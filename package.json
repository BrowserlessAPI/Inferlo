{
  "name": "@browserlessapi/inferlo",
  "version": "0.4.0",
  "description": "The enterprise-ready TypeScript backend framework, with AI models built in: routing, validation, PostgreSQL and migrations, auth, rate limiting, jobs, OpenAPI and MCP, plus Anthropic, OpenAI, Gemini, Ollama and OpenAI-compatible models.",
  "type": "module",
  "license": "MIT",
  "author": "BrowserlessAPI",
  "homepage": "https://github.com/BrowserlessAPI/Inferlo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrowserlessAPI/Inferlo.git"
  },
  "bugs": "https://github.com/BrowserlessAPI/Inferlo/issues",
  "keywords": [
    "typescript",
    "backend",
    "framework",
    "api",
    "rest",
    "orm",
    "validation",
    "ai",
    "llm",
    "mcp",
    "ai-agents",
    "bun",
    "deno",
    "edge"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/public.d.ts",
      "default": "./dist/ai/public.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./postgres": {
      "types": "./dist/db/postgres.d.ts",
      "default": "./dist/db/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "inferlo": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/helpdesk && tsc --noEmit -p examples/with-hono && tsc --noEmit -p examples/with-express && tsc --noEmit -p examples/with-fastify",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\" \"examples/*/test/*.test.ts\"",
    "test:bun": "bun test test/",
    "llms": "node scripts/build-llms.ts",
    "check": "npm run typecheck && npm test && node scripts/build-llms.ts --check",
    "bench": "node bench/run.ts"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.16",
    "pg": "^8.16.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
